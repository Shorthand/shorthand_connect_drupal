# Database Configuration
DB_ROOT_PASSWORD=rootpassword
DB_NAME=drupaldb
DB_USER=drupaluser
DB_PASSWORD=drupalpass

# Drupal Configuration
DRUPAL_HASH_SALT=aVeryLongRandomStringThatShouldBeChangedInProduction123456789
DRUPAL_ADMIN_USER=admin
DRUPAL_ADMIN_PASSWORD=drupal

# Site Configuration
SITE_NAME=Shorthand Development
SITE_MAIL=admin@drupal.local

# Development Settings
XDEBUG_MODE=develop,debug,coverage
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300

# SSL Certificate Paths (relative to _docker directory)
SSL_CERT_PATH=./certificates/dylan.crt
SSL_KEY_PATH=./certificates/dylan.key

# Ports
HTTP_PORT=80
HTTPS_PORT=443
DB_PORT=3306
ADMINER_PORT=8080
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# API Configuration (for Shorthand)
SHORTHAND_API_URL=https://api.dylan.local/